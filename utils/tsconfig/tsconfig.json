{
	"compilerOptions": {
		"target": "ES2015",
		"lib": ["ES2015", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": false,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx"
	}
}
