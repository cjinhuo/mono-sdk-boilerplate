{
	"name": "changesets-toolkit",
	"description": "toolkit for changesets which make commit message more automatic and changelogs more readable",
	"version": "0.1.0",
	"author": {
		"name": "cjinhuo",
		"email": "cjinhuo@qq.com",
		"url": "https://cjinhuo.netlify.com/"
	},
	"license": "MIT",
	"bin": {
		"changeset_version": "./dist/bin/changeset_version.js",
		"changeset_publish": "./dist/bin/changeset_publish.js"
	},
	"files": [
		"dist",
		"README.md",
		"README_zh.md"
	],
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "pnpm --workspace-root exec vitest run --project changesets"
	},
	"devDependencies": {
		"@changesets/types": "catalog:",
		"@types/minimist": "catalog:",
		"@types/micromatch": "catalog:"
	},
	"peerDependencies": {
		"@changesets/cli": "^3.0.0"
	},
	"engines": {
		"node": "^22.11 || ^24 || >=26",
		"pnpm": ">=11"
	},
	"dependencies": {
		"consola": "catalog:",
		"fast-glob": "catalog:",
		"micromatch": "catalog:",
		"axios": "catalog:",
		"dayjs": "catalog:",
		"execa": "catalog:",
		"minimist": "catalog:"
	},
	"type": "commonjs"
}
