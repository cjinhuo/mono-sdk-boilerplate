{
	"name": "mono",
	"version": "0.0.1",
	"private": true,
	"description": "the best monorepo",
	"workspaces": [
		"packages/*",
		"utils/*",
		"app/*",
		"e2e",
		"e2e/demos/*"
	],
	"scripts": {
		"commit": "git czg",
		"prepare": "husky",
		"build": "nx run-many -t build --parallel=4",
		"esm": "pnpm build",
		"watch:esm": "nx watch --all --initialRun --verbose -- nx run-many -t build --parallel=4",
		"typecheck": "nx run-many -t typecheck --parallel=4 && tsc -p tsconfig.test.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:packages": "node --test scripts/verify-packages.mjs",
		"test:e2e": "pnpm --filter @mono/e2e exec playwright test",
		"test:release": "node --test scripts/verify-release.mjs",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:packages && pnpm test:e2e && pnpm test:release",
		"web:dev": "pnpm --filter @mono/react-19 dev",
		"e2e:dev": "pnpm --filter @mono/react-e2e-demo dev",
		"clean": "node scripts/clean.mjs",
		"changeset_version": "node utils/changesets/dist/bin/changeset_version.js",
		"changeset_publish": "node utils/changesets/dist/bin/changeset_publish.js"
	},
	"engines": {
		"node": "^24.15.0",
		"pnpm": ">=12"
	},
	"author": "cjinhuo",
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@types/node": "catalog:",
		"@types/minimist": "catalog:",
		"@types/micromatch": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"czg": "catalog:",
		"fast-glob": "catalog:",
		"husky": "catalog:",
		"lint-staged": "catalog:",
		"nx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"@mono/tsconfig": "workspace:*",
		"changesets-toolkit": "workspace:*"
	},
	"type": "module",
	"packageManager": "pnpm@12.16.1"
}
