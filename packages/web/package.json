{
	"name": "@mono/web",
	"version": "0.0.1",
	"description": "@mono/web",
	"author": "cjinhuo",
	"license": "MIT",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.esm.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/finalize-library.mjs",
		"esm": "pnpm build",
		"watch:esm": "pnpm --workspace-root watch:esm",
		"build:cjs": "pnpm build",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm --workspace-root exec vitest run --project web",
		"lint": "biome check src"
	},
	"devDependencies": {
		"@mono/tsconfig": "workspace:*",
		"@mono/core": "workspace:*",
		"@mono/shared": "workspace:*"
	},
	"type": "commonjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.js"
			}
		},
		"./dist/index.esm.js": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	}
}
