{
	"extends": "./utils/tsconfig/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"customConditions": ["node"]
	},
	"include": [
		"packages/*/src/**/*.ts",
		"utils/changesets/src/**/*.ts",
		"utils/vite/**/*.ts",
		"vitest.config.mts",
		"packages/*/vite.config.mts",
		"app/*/vite.config.ts",
		"e2e/demos/*/vite.config.ts"
	]
}
